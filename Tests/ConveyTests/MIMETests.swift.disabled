import Foundation
import Testing
import Convey

@Suite("MIME Uploads")
struct MIMETests {
	@Test("MIME task encodes text and image components")
	func encodesTextAndImageComponents() throws {
		let image = try #require(PlatformImage(named: "small_black_square", in: .module, with: nil))
		 let components: [MIMEMessageComponent] = [
			.text(content: "Here is the first field"),
			.image(name: "test image", image: image, quality: 0.9)
		 ]

		 let task = SimpleMIMETask(url: URL(string: "http://test.com")!, components: components)
		 
		 let data = try #require(task.dataToUpload)
		 let text = try #require(String(data: data, encoding: .ascii))
		 #expect(text.contains("Here is the first field"))
		 #expect(text.contains("test image"))
	}
}
